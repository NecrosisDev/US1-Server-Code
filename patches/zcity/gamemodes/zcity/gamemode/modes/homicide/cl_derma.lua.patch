 local function set_role(role, mode)
 	if mode == "soe" then
 		RunConsoleCommand(MODE.ConVarName_SubRole_Traitor_SOE, role)
+	elseif mode == "gunfreezone" then
+		RunConsoleCommand(MODE.ConVarName_SubRole_Traitor_GFZ, role)
 	else
 		RunConsoleCommand(MODE.ConVarName_SubRole_Traitor, role)
 	end
 end
 
+-- which convar holds the current pick for a given picker mode (soe / gunfreezone / standard)
+local function mode_convar(mode)
+	if mode == "soe" then return MODE.ConVar_SubRole_Traitor_SOE end
+	if mode == "gunfreezone" then return MODE.ConVar_SubRole_Traitor_GFZ end
+	return MODE.ConVar_SubRole_Traitor
+end
