+-- A yield is valid only inside our own transition coroutine. Other callers stay synchronous.
+function zb:TransitionYield()
+    local job = self.ReplayTransition
+    if job and coroutine.running() == job.co then coroutine.yield() end
+end
+
+function zb:PrepareReplayRound()
+	zb.ROUND_STATE = 0
+
+	zb.SHOULD_FADE = true
+
+	hook.Run("ZB_PreRoundStart")
+	hook.Run("TTTPrepareRound") -- stormfox2 random_round_weather
+
+	zb.CROUND = zb.nextround or "hmcd"
+	if CurrentRound().shouldfreeze then zb:Freeze() end
+
+	--PrintMessage(HUD_PRINTTALK, "Gamemode: " .. CurrentRound().PrintName or "None")
+
+	local mode, round = CurrentRound()
+	net.Start("RoundInfo")
+		net.WriteString(mode.name or "hmcd")
+		net.WriteInt(zb.ROUND_STATE, 4)
+	net.Broadcast()
+
+	hg.UpdateRoundTime(CurrentRound().ROUND_TIME, CurTime(), math.max(CurTime(), self.ReplayTransition.releaseAt) + (CurrentRound().start_time or 5))
+
+	self:TransitionYield()
+	self:KillPlayers()
+	self:TransitionYield()
+	self:AutoBalance()
+	self:TransitionYield()
+
+	if hg.PluvTown.Active then
+		for _, ply in player.Iterator() do
+			if IsValid(ply) then ply:SetNetVar("CurPluv", "pluv") end
+			self:TransitionYield()
+		end
+	end
+
+	CurrentRound().saved = {}
+
+	self:TransitionYield()
+	CurrentRound():Intermission()
+	self:TransitionYield()
+	CurrentRound():GiveEquipment()
+	self:TransitionYield()
+end
+
+function zb:BeginReplayTransition(releaseAt)
+    if self.ReplayTransition or self.ROUND_STATE ~= 3 then return false end
+    if not isnumber(releaseAt) or releaseAt ~= releaseAt or math.abs(releaseAt) == math.huge then return false end
+    local nextMode = self.modes[self:GetMode(self.nextround or "hmcd")]
+    -- Modes opt into early preparation only after their Intermission timers are audited.
+    if releaseAt > CurTime() and not (nextMode and nextMode.ReplayPreparationSupported) then return false end
+    local job = {releaseAt = releaseAt, started = CurTime()}
+    job.co = coroutine.create(function() self:PrepareReplayRound() end)
+    self.ReplayTransition = job
+    return true
+end
+
+function zb:StepReplayTransition()
+    local job = self.ReplayTransition
+    if not job then return end
+    if (not job.entered and self.ROUND_STATE ~= 3) or
+        (job.entered and (self.ROUND_STATE ~= 0 or self.CROUND ~= job.mode)) then
+        self.ReplayTransition = nil -- staff/mode change invalidates unfinished work
+        return
+    end
+    if not job.done then
+        local ok, err = coroutine.resume(job.co) -- at most one player or stage each server tick
+        if not job.entered then job.entered, job.mode = true, self.CROUND end
+        if not ok then
+            ErrorNoHalt("[Round transition] " .. tostring(err) .. "\n")
+            job.error = tostring(err)
+        end
+        job.done = not ok or coroutine.status(job.co) == "dead"
+    end
+    local deadline = self.END_TIME
+    if isnumber(deadline) and deadline == deadline and deadline < math.huge and deadline > job.releaseAt then
+        job.releaseAt = deadline -- preserve later holds from the round owner
+    end
+    if job.done and CurTime() >= job.releaseAt then
+        self.ReplayTransition = nil
+        local mode = CurrentRound()
+        if mode.ReplayPreparationFinished then
+            local ok, err = pcall(mode.ReplayPreparationFinished, mode)
+            if not ok then ErrorNoHalt("[Round preparation clocks] " .. tostring(err) .. "\n") end
+        end
+        self.START_TIME = CurTime() + (CurrentRound().start_time or 5)
+        hg.UpdateRoundTime(CurrentRound().ROUND_TIME, CurTime(), self.START_TIME)
+    end
+end
+hook.Add("Think", "ZB.ReplayTransition", function() zb:StepReplayTransition() end)
