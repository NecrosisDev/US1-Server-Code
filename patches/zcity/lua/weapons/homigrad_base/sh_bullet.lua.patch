+local function firePelletVolley(weapon, bullet, numbullet, penetration, diameter, usesLuaBullets, volleyContext, owner, suicideShot, headpos, ent, dir)
+	for i = 1, numbullet do
+		local pellet = CopyPelletBullet(bullet)
+		pellet.penetrated = 0
