+			dmginfo:SetAttacker(owner)
+			dmginfo:SetDamageType(DMG_BULLET)
+			dmginfo:SetDamageForce(dir * pellet.Force)
+			dmginfo:SetDamagePosition(headpos)
+			ent:TakeDamageInfo(dmginfo)
