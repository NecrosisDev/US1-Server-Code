+		pellet.Penetration = penetration
+		pellet.Diameter = diameter
+		pellet.__ZCVolley = volleyContext
+		pellet.__ZCPelletIndex = i
+		if SERVER and suicideShot then
+			local dmginfo = DamageInfo()
