 -- A function to query the MySQL database.
+-- Do not turn a disconnected database into a fake success or nil-method cascade.
+local function DatabaseUnavailable(db,reason)
+    db.ZCFailedUnavailable=(db.ZCFailedUnavailable or 0)+1
+    db.ZCLastUnavailable=reason
+    local now=RealTime()
+    if not db.ZCUnavailableLoggedAt or now-db.ZCUnavailableLoggedAt>=60 then
+        db.ZCUnavailableLoggedAt=now
+        file.CreateDir("zc_database")
+        file.Append("zc_database/unavailable.txt",os.date().." "..reason.."; rejected="..db.ZCFailedUnavailable.."\n")
+        if not db.ZCUnavailableWarned then
+            db.ZCUnavailableWarned=true
+            ErrorNoHalt("[ZCity database] Database unavailable; persistence is NOT confirmed. See data/zc_database/unavailable.txt\n")
+        end
+    end
+    return false,reason
+end
+
