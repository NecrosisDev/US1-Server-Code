 	if (self.module == "mysqloo") then
-		local queryObj = self.connection:query(query)
+        if not istable(mysqloo) or not self.connection or not isfunction(self.connection.query) then
+            return DatabaseUnavailable(self, "MySQLOO connection is unavailable")
+        end
+        local queryObj = self.connection:query(query)
+        if not queryObj then return DatabaseUnavailable(self, "MySQLOO did not return a query object") end
 
