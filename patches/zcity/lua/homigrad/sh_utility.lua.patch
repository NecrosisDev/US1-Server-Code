+-- 2026-09-24: one place decides a class's voice effect (Combine/Metrocop = mask voice, furry = proot). Combine used PROOT as a placeholder.
+function hg.ClassVoiceEffect(ply)
+	if not eightbit or not IsValid(ply) then return 0 end
+	local c = ply.PlayerClassName
+	if c == "furry" then return eightbit.EFF_PROOT or 0 end
+	if c == "Combine" or c == "Metrocop" then return eightbit.EFF_MASKVOICE or 0 end
+	return eightbit.EFF_NONE or 0
+end
 
