+-- The root colour pass is skipped when it would be an identity pass. DrawColorModify (lua/postprocess/color_modify.lua)
+-- copies the screen and draws a quad on every call and only sets the keys it is given, so the keys other effects left on
+-- the shared pp/colour material are checked too; the three keys in tab are still written so that material state is unchanged.
+-- Skipping also skips DrawColorModify's copy into the screen-effect texture. Nothing later depends on that copy:
+-- sh_equiprender's visor/mask/head overlays draw their own materials and its blur calls render.UpdateScreenEffectTexture itself.
+local colourModMat = Material("pp/colour")
+local colourModLeftover = {"$pp_colour_addr", "$pp_colour_addg", "$pp_colour_addb", "$pp_colour_mulr", "$pp_colour_mulg", "$pp_colour_mulb", "$pp_colour_inv"}
+local function colourModIsIdentity(brightness)
+	if math.abs(brightness) >= 0.002 then return false end
+	for i = 1, #colourModLeftover do
+		local v = colourModMat:GetFloat(colourModLeftover[i])
+		if v and math.abs(v) >= 0.002 then return false end
+	end
+	return true
+end
+
