+-- A corpse is rebroadcast (bareinfo + wounds) to its PVS every 3 s forever,
+-- long after it has bled out and nothing in it changes. Once two sends in a
+-- row carry the same state, hold 15 s; any change returns it to 3 s.
+-- PROVISIONAL(2026-09-21, 15 s is a guess at how stale a settled body may look to someone who just arrived, ratify-by: 2026-10-05)
+local CORPSE_SETTLED_HOLD = 15
+local function corpseSig(org)
+	local o2 = org.o2
+	return table.concat({
+		tostring(org.blood), tostring(org.pulse), tostring(org.heartbeat), tostring(org.analgesia),
+		tostring(istable(o2) and o2[1] or o2), tostring(org.otrub), tostring(org.alive),
+		tostring(org.lleg), tostring(org.rleg), tostring(org.larm), tostring(org.rarm),
+		tostring(org.llegamputated), tostring(org.rlegamputated), tostring(org.larmamputated),
+		tostring(org.rarmamputated), tostring(org.headamputated),
+		tostring(istable(org.wounds) and #org.wounds), tostring(istable(org.arterialwounds) and #org.arterialwounds),
+		tostring(istable(org.LodgedEntities) and table.Count(org.LodgedEntities)),
+		tostring(istable(org.bullets) and #org.bullets),
+	}, "|")
+end
+hg.organism.corpseSig = corpseSig
+
+-- PROVISIONAL(2026-09-23, retained-bullet tracking for exit-wound/foreign-object extraction project, ratify-by: 2026-10-07)
+function hg.organism.AddRetainedBullet(org, rec)
+	org.bullets = org.bullets or {}
+	if #org.bullets >= 12 then
+		local dropped = table.remove(org.bullets, 1)
+		-- the evicted record's wound must coagulate normally again, or it weeps forever with no record to reach it
+		if dropped and istable(dropped.wound) then dropped.wound[6] = nil dropped.wound[7] = nil end
+	end
+	table.insert(org.bullets, {
+		ammo = rec.ammo,
+		organ = rec.organ,
+		bone = rec.bone,
+		lpos = rec.lpos,
+		frag = rec.frag or false,
+		t = CurTime(),
+		wound = nil,
+	})
+	return #org.bullets
+end
+
+function hg.organism.RemoveRetainedBullet(org, i)
+	if not istable(org.bullets) then return nil end
+	local rec = org.bullets[i]
+	if not rec then return nil end
+	if istable(rec.wound) then rec.wound[6] = nil end
+	table.remove(org.bullets, i)
+	return rec
+end
+
