+-- Organs v2 (organs_20260925): kidneys, spleen and bladder are hitboxes now (sh_hitboxorgans_manual.lua ORGANS2);
+-- these are their first handlers, shaped like the liver's but smaller. org.<key> is the organ's 0..1 damage.
+-- PROVISIONAL(2026-09-25, kidneys bleed and hurt, the spleen bleeds quietly, the bladder mostly hurts; numbers are
+-- fractions of the liver's 20 shock / 35 pain per unit, ratify-by: 2026-10-09)
+local function bleedingOrgan(key, pain, bleed, harm)
+	return function(org, bone, dmg, dmgInfo)
+		local before = org[key] or 0
+		org[key] = before
+		local result = damageOrgan(org, dmg, dmgInfo, key)
+		local harmed = (org[key] or 0) - before
+		hg.AddHarmToAttacker(dmgInfo, harmed * harm, key .. " damage harm")
+		org.shock = org.shock + dmg * 10
+		org.painadd = org.painadd + dmg * pain
+		org.internalBleed = org.internalBleed + harmed * bleed
+		return result
+	end
+end
+input_list.kidneyL = bleedingOrgan("kidneyL", 30, 4, 3)
+input_list.kidneyR = bleedingOrgan("kidneyR", 30, 4, 3)
+input_list.spleen = bleedingOrgan("spleen", 12, 6, 3)
+input_list.bladder = bleedingOrgan("bladder", 20, 1, 1)
