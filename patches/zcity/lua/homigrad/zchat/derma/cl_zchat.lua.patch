+			end
+			if (self.ZCHighlightUntil or 0) > CurTime() then draw.RoundedBox(0, self.ZCBubbleX, 0, self.ZCBubbleWidth, self.ZCBubbleBodyHeight, Color(255,25,25,40)) end
+			self.markup:draw(self.ZCTextX, (ZCPhoneSettings and ZCPhoneSettings.ReducedMotion() and 0 or self.yAnim) + (self.ZCBubble and 4 or 0) + (self.ZCQuoteHeight or 0), nil, nil, newAlpha)
