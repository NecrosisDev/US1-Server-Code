+function PANEL:SetPhonePage(page, quiet)
+    if page ~= "chat" and page ~= "home" and not (ZCGoobApps and ZCGoobApps.Registry[page]) then return end
+    if self.phonePage == page then return end
+    local previous = self.phonePage
+    self.phonePage = page
+    self.phonePageChanged = CurTime()
+    local chatPage = page == "chat"
+    if not chatPage then
+        if ZCChatThreads and ZCChatThreads.CloseDirectory then ZCChatThreads.CloseDirectory(self) end
+        ZCChatMedia.ClosePicker()
+        if ZCChatMedia.StopVideo then ZCChatMedia.StopVideo() end
+        self.entry:KillFocus()
+    else self.phoneUnread = 0 end
+    self.history:SetVisible(chatPage and not IsValid(ZCChatMedia.Picker))
+    self.entrySlot:SetVisible(chatPage)
+    self.phoneHome:SetVisible(page == "home" and self:GetActive())
+    if ZCGoobApps then ZCGoobApps.Open(self, page); ZCGoobApps.Sync(self) end
+    if self:GetActive() then
+        if chatPage and not quiet then
+            hook.Run((not ZCChatThreads or not ZCChatThreads.IsMain or ZCChatThreads.IsMain(self)) and "StartChat" or "FinishChat")
+            self.entry:RequestFocus()
+        elseif not chatPage and previous == "chat" then hook.Run("FinishChat") end
+    end
+    self:InvalidateLayout(true)
+end
+
+function PANEL:PerformLayout(w, h)
+	if ZCGoobApps then ZCGoobApps.Layout(self, w, h) end
+	if ZCChatThreads then ZCChatThreads.Layout(self,w,h) end
+	if IsValid(self.phoneBar) then
+		self.phoneBar:SetSize(w, 40)
+		self.phoneBar:SetPos(0, 0)
+		self.phoneBar:MoveToFront()
+		self.phoneClose:SetPos(w - 64, 6)
+		self.mediaVisibilityButton:SetPos(w - 132, 6)
+		self.betaBadge:SetPos(46, 11)
+		self.phoneHome:SetPos(0, 44)
+		self.phoneHome:SetSize(w, h - 44)
+		self.chatApp:SetPos(24, h - 44 >= 242 and 119 or 14)
+	end
+	if IsValid(self.resizeHandle) then
+		self.resizeHandle:SetPos(w - 28, 0)
+		self.resizeHandle:MoveToFront()
+	end
+	if IsValid(self.bannerMuteButton) then self.bannerMuteButton:MoveToFront() end
+end
+
+function PANEL:LayoutSystemBanners()
+	if not IsValid(self.bannerMuteButton) or not IsValid(self.entrySlot) or not IsValid(self.keyOrb) then return end
+	local orbX, orbY = self.keyOrb:LocalToScreen(0, 0)
+	local panelX, panelY = self:LocalToScreen(0, 0)
+	if self:GetActive() then
+		self.bannerMuteButton:SetVisible(true)
+		self.bannerMuteButton:SetPos(self:GetWide() - 98, 6)
+	else
+		self.bannerMuteButton:SetVisible(false)
+	end
+	local openY = panelY + (self.phonePage=="chat" and 96 or 48)
+	local closedX = orbX + self.keyOrb:GetWide() + 6
+	local closedHeight = 0
+	local lastHeight = 0
+	for i, notice in ipairs(self.bannerNotices or {}) do
+		if IsValid(notice) then
+			local width = math.max(120, self:GetWide() - (self:GetActive() and 64 or closedX - panelX + 6))
+			local maxLines = self:GetActive() and 4 or 2
+			if notice.ZCWrapWidth ~= width or notice.ZCWrapLines ~= maxLines then
+				notice.ZCWrapWidth = width
+				notice.ZCWrapLines = maxLines
+				notice.ZCLines = WrapSystemBannerText(notice.ZCMessage, width - 24, maxLines)
+				notice:SetSize(width, math.max(32, #notice.ZCLines * 16 + 14))
+			end
+			if self:GetActive() then
+				notice:SetPos(panelX + 32, openY)
+				openY = openY + notice:GetTall() + 4
+			else
+				closedHeight = closedHeight + notice:GetTall() + 4
+				lastHeight = notice:GetTall()
+			end
+		end
+	end
+	if not self:GetActive() then
+		local closedY = orbY - math.max(0, closedHeight - 4 - lastHeight)
+		self.ZCClosedNoticeTop = closedY
+		for _, notice in ipairs(self.bannerNotices or {}) do
+			if IsValid(notice) then
+				notice:SetPos(closedX, closedY)
+				closedY = closedY + notice:GetTall() + 4
+			end
+		end
+	end
+end
+
+function PANEL:UpdatePhoneVisibility()
+    local home = self:GetActive() and self.phonePage == "home"
+    local nonChat = self:GetActive() and self.phonePage ~= "chat"
+    self.phoneHome:SetVisible(home)
+    self.entrySlot:SetVisible(not nonChat)
+    self.history:SetVisible(not nonChat and not IsValid(ZCChatMedia.Picker))
+    self.mediaVisibilityButton:SetVisible(self:GetActive() and not nonChat)
+    if ZCGoobApps then ZCGoobApps.Sync(self) end
+    return nonChat
+end
+
+-- True while the closed chat draws nothing: frame faded out, no close animation running, every line faded (row.alpha
+-- drives the row and its media children, zc_chat_media/client.lua:755), no highlight. Rechecked every 0.25 s; adding
+-- or re-marking-up a line holds it off for 1 s (a new line fades in from alpha 0 over 0.5 s). While quiet, Think skips
+-- the per-line walk and Paint skips PaintManual.
+function PANEL:ZCWake()
+	self.ZCQuietUntil = nil
+	self.ZCQuiet = false
+	self.ZCWakeUntil = RealTime() + 1
+end
+
+function PANEL:ZCHistoryQuiet()
+	if self:GetActive() or (self.frameAlpha or 0) >= 0.5 then self.ZCQuietUntil = nil return false end
+	local now = RealTime()
+	if self.ZCWakeUntil and now < self.ZCWakeUntil then return false end
+	if self.ZCQuietUntil and now < self.ZCQuietUntil then return true end
+	self.ZCQuietUntil = nil
+	if self.closeTime and CurTime() - self.closeTime < 1 then return false end
+	local curTime = CurTime()
+	for _, row in ipairs(self.entries) do
+		if IsValid(row) and ((row.alpha or 0) >= 0.5 or (row.ZCHighlightUntil or 0) > curTime) then return false end
+	end
+	self.ZCQuietUntil = now + 0.25
+	return true
+end
+
+function PANEL:Think()
+	local home = self:UpdatePhoneVisibility()
+	-- Owner 2026-09-24 (late): the GoobOS death / round-end panels reserve a rectangle for the chat (ZCChatDock, published
+	-- by lua/zc_goobos/panels.lua P.ChatDock every frame a panel is up). The frame moves into it and draws on top of the
+	-- panel; when the rect goes stale it returns to its corner at its cookie size. Resizing is off while docked.
+	local dock = ZCChatDock
+	if istable(dock) and RealTime() - (dock.at or 0) < 0.5 then
+		if not self.ZCDocked then
+			self.ZCDocked = true
+			self:SetDrawOnTop(true)
+		end
+		if self:GetX() ~= dock.x or self:GetY() ~= dock.y or self:GetWide() ~= dock.w or self:GetTall() ~= dock.h then
+			self:SetSize(dock.w, dock.h)
+			self:SetPos(dock.x, dock.y)
+		end
+		if not self.bActive then self:MoveToFront() end
+	elseif self.ZCDocked then
+		self.ZCDocked = nil
+		self:SetDrawOnTop(false)
+		local width = math.Clamp(cookie.GetNumber("zchat_width", ScrW() * 0.42), 384, ScrW() - 16)
+		local height = math.Clamp(cookie.GetNumber("zchat_height", ScrH() * 0.4), 180, ScrH() * 0.65)
+		self:SetSize(width, height)
+		self:SetPos(0, ScrH() - height)
+	end
+	-- Owner 2026-09-24: an open chat owns the keyboard. Another popup (a briefing, a menu, a frame a round transition
+	-- opens) may take the focus; unless the player is typing into it, the chat takes the focus straight back.
+	if self.bActive and self.phonePage == "chat" and IsValid(self.entry) and not IsValid(ZCChatMedia.Picker) and not gui.IsGameUIVisible() then
+		local focus = vgui.GetKeyboardFocus()
+		if not (IsValid(focus) and (focus == self or focus:HasParent(self))) then
+			local editing = IsValid(focus) and isfunction(focus.IsEditing) and focus:IsEditing() == true
+			if not editing then self:MoveToFront() self.entry:RequestFocus() end
+		end
+	end
+	local reducedMotion = ZCPhoneSettings and ZCPhoneSettings.ReducedMotion()
+	local t = reducedMotion and 1 or math.Clamp((CurTime() - self.fadeStart) / 0.25, 0, 1)
+	self.frameAlpha = Lerp(t * t * (3 - 2 * t), self.fadeFrom, self.fadeTo)
+	local pageT = reducedMotion and 1 or math.Clamp((CurTime() - self.phonePageChanged) / 0.16, 0, 1)
+	local pageAlpha = 255 * pageT * pageT * (3 - 2 * pageT)
+	self.phoneHome:SetAlpha(pageAlpha * self.frameAlpha / 255)
+	self.history:SetAlpha(self:GetActive() and not home and pageAlpha or 255)
+	self.phoneBar:SetVisible(self.frameAlpha > 0.5)
+	self.phoneBar:SetAlpha(self.frameAlpha)
+	self.phoneBar:SetMouseInputEnabled(self:GetActive())
+	if not self.phoneClockAt or RealTime() >= self.phoneClockAt then
+		self.phoneClock, self.phoneDate = os.date("%H:%M"), os.date("%A, %B %d")
+		self.phoneClockAt = RealTime() + 1
+	end
+	self.composeBlend = ZCPhoneSettings and ZCPhoneSettings.ReducedMotion() and (self:GetActive() and 1 or 0) or self.frameAlpha / 255
+	if IsValid(self.entryPanel) and IsValid(self.entrySlot) then
+		local slotWidth = self.entrySlot:GetWide()
+		local width = math.max(1, slotWidth * self.composeBlend)
+		self.entryPanel:SetSize(width, 40)
+		self.entryPanel:SetPos(0, 0)
+		self.entryPanel:SetAlpha(self.composeBlend * 255)
+		self.entryPanel:SetVisible(self.composeBlend > 0.01)
+		if IsValid(self.keyOrb) then
+			local endX, endY = self.entrySlot:LocalToScreen(slotWidth - 40, 0)
+			local orbX, orbY = 4, ScrH() - 44 -- owner 2026-09-25: corner idle spot, same as the initial SetPos above
+			if self.ZCDocked then orbX, orbY = self:GetX() + 8, self:GetY() + self:GetTall() - 48 end -- the orb sits in the dock too
+			self.keyOrb:SetPos(Lerp(self.composeBlend, orbX, endX),
+				Lerp(self.composeBlend, orbY, endY))
+			self.keyOrb:SetAlpha(255 * math.Clamp((1 - self.composeBlend) / 0.25, 0, 1))
+			self.keyOrb:MoveToFront()
+		end
+		if IsValid(self.ZCEmoteButton) then
+			self.ZCEmoteButton:SetAlpha(255 * math.Clamp((self.composeBlend - 0.75) / 0.25, 0, 1))
+		end
+	end
+	ZCChatMedia.UpdateReplyComposer(self)
+	self.ZCQuiet = self:ZCHistoryQuiet()
+	if not self.ZCQuiet and IsValid(self.historySpacer) then
+		local rowsHeight = 0
+		for _, row in ipairs(self.entries) do
+			if IsValid(row) then
+				rowsHeight = rowsHeight + row:GetTall() + (row.ZCTopGap or 0)
+				if ZCChatMedia and ZCChatMedia.UpdateRowActions then
+                    ZCChatMedia.UpdateRowActions(row, self)
+                    local mx,my=row:LocalCursorPos()
+                    local hovered=mx>=0 and mx<=row:GetWide() and my>=0 and my<=row:GetTall()
+                    if hovered then row.ZCActionHoverUntil=RealTime()+0.18 end
+                    if not hovered and RealTime()>(row.ZCActionHoverUntil or 0) then
+                        if IsValid(row.ZCReactionAdd) then row.ZCReactionAdd:SetVisible(false) end
+                        if IsValid(row.ZCReportButton) then row.ZCReportButton:SetVisible(false) end
+                        if IsValid(row.ZCModerationButton) then row.ZCModerationButton:SetVisible(false) end
+                    end
+                end
+			end
+		end
+		local targetHeight = math.max(0, self.history:GetTall() - rowsHeight)
+		local currentHeight = self.historySpacer:GetTall()
+		local nextHeight = ZCPhoneSettings and ZCPhoneSettings.ReducedMotion() and targetHeight or Lerp(math.Clamp(FrameTime() * 16, 0, 1), currentHeight, targetHeight)
+		if #self.entries == 0 then nextHeight = targetHeight end
+		if math.abs(nextHeight - targetHeight) < 0.5 then nextHeight = targetHeight end
+		if math.abs(nextHeight - currentHeight) >= 0.5 then self.historySpacer:SetTall(nextHeight) end
+	end
+	ZCChatMedia.UpdateScroll(self)
+	if self.scrollStart and IsValid(self.history) then
+		local bar = self.history:GetVBar()
+		local fraction = ZCPhoneSettings and ZCPhoneSettings.ReducedMotion() and 1 or math.Clamp((CurTime() - self.scrollStart) / 0.25, 0, 1)
+		bar:SetScroll(Lerp(fraction * fraction * (3 - 2 * fraction), self.scrollFrom or 0, bar.CanvasSize or 0))
+		if fraction >= 1 then self.scrollStart = nil end
+	end
+	if IsValid(self.resizeHandle) then self.resizeHandle:SetVisible(self:GetActive()) end
+	if IsValid(self.betaBadge) then
+		self.betaBadge:SetVisible(self:GetActive())
+		self.betaBadge:SetAlpha(self.frameAlpha)
+		self.betaBadge:MoveToFront()
+	end
+	self:LayoutSystemBanners()
+	ZCChatThreads.Think(self)
+end
+
+function PANEL:Paint(w, h)
+	local fade = self.frameAlpha / 255
+	ZC_FRAME_EDGE.a = 180 * fade
+	ZC_FRAME_FILL.a = ZC_PANEL.a * fade
+	draw.RoundedBox(4, 0, 0, w, h, ZC_FRAME_EDGE)
+	draw.RoundedBox(4, 1, 1, w - 2, h - 2, ZC_FRAME_FILL)
+
+	surface.SetAlphaMultiplier(1)
+		if not self.ZCQuiet and not (self:GetActive() and self.phonePage ~= "chat") and not IsValid(ZCChatMedia.Picker) and not IsValid(self.ZCDirectory) then self.history:PaintManual() end
+		ZCChatThreads.Draw(self,w,h)
+		local bar = self.history:GetVBar()
+		bar:SetAlpha(self:GetActive() and 255 or 0)
+	surface.SetAlphaMultiplier(1)
+
+	DisableClipping(true)
+		if LocalPlayer().organism and LocalPlayer().organism.otrub  then
+			local noticeY = h + 6
+			local noticeAlpha = self:GetActive() and 255 or 80
+			draw.SimpleText("Your messages are currently not visible to anyone.", "zChatFontSmall", w - 4 + 1, noticeY + 1,
+				Color(ZC_SHADOW.r, ZC_SHADOW.g, ZC_SHADOW.b, noticeAlpha), TEXT_ALIGN_RIGHT)
+			draw.SimpleText("Your messages are currently not visible to anyone.", "zChatFontSmall", w - 4, noticeY,
+				Color(ZC_ACCENT.r, ZC_ACCENT.g, ZC_ACCENT.b, noticeAlpha), TEXT_ALIGN_RIGHT)
+		end
+	DisableClipping(false)
+
+end
+
+function PANEL:SetActive(bActive, bRemovePrev)
+	self.fadeFrom = self.frameAlpha
+	self.fadeTo = bActive and 255 or 0
+	self.fadeStart = CurTime()
+	if (bActive) then
+		self:SetPhonePage("chat", true)
+		self.phoneUnread = 0
+		self.closeTime = nil
+		self.openTime = CurTime()
+		local _, top = self.history:LocalToScreen(0, 0)
+		local bottom = top + self.history:GetTall()
+		local visible = {}
+		for _, row in ipairs(self.entries) do
+			if IsValid(row) then
+				row.ZCOpenedAt = self.openTime
+				row.ZCOpenOrder = 0
+				local _, y = row:LocalToScreen(0, 0)
+				if y < bottom and y + row:GetTall() > top then visible[#visible + 1] = row end
+			end
+		end
+		for i, row in ipairs(visible) do
+			row.ZCOpenOrder = #visible > 1 and (#visible - i) / (#visible - 1) or 0
+		end
+		self:MakePopup()
+		if IsValid(self.entryPanel) then self.entryPanel:SetVisible(true) end
+		self.entry:RequestFocus()
+
+		input.SetCursorPos(self:LocalToScreen(10, self:GetTall() + 10))
+
+		hook.Run("StartChat")
+	else
+		self.closeTime = CurTime()
+		local _, top = self.history:LocalToScreen(0, 0)
+		local bottom = top + self.history:GetTall()
+		local visible = {}
+		for i, row in ipairs(self.entries) do
+			if IsValid(row) then
+				row.ZCClosedAt = self.phonePage == "chat" and self.closeTime or nil
+				row.ZCCloseOrder = 0
+				local _, y = row:LocalToScreen(0, 0)
+				if y < bottom and y + row:GetTall() > top then visible[#visible + 1] = row end
+			end
+		end
+		for i, row in ipairs(visible) do
+			row.ZCCloseOrder = #visible > 1 and (i - 1) / (#visible - 1) or 0
+		end
+		ZCChatMedia.ClosePicker()
+		self.resizing = false
+		if IsValid(self.resizeHandle) then self.resizeHandle:MouseCapture(false) end
+		self:SetMouseInputEnabled(false)
+		self:SetKeyboardInputEnabled(false)
+
+		if bRemovePrev then
+			self.entry:SetText("")
+			self.entry.prevText = ""
+		end
+
+		gui.EnableScreenClicker(false)
+
+		hook.Run("FinishChat")
+	end
+
+	self.bActive = bActive
+	if ZCGoobApps then ZCGoobApps.Sync(self) end
+	ZCChatThreads.OnActive(self,bActive)
+
+	local bar = self.history:GetVBar()
+	bar:SetScroll(bar.CanvasSize)
+end
+
+function PANEL:AnimateAlpha(newAlpha)
+	self:CreateAnimation(1, {
+		index = 1,
+		target = {alpha = newAlpha},
+	})
+end
+
+function PANEL:AnimateRealAlpha(newAlpha)
+	self:CreateAnimation(1, {
+		index = 2,
+		target = {realAlpha = newAlpha},
+	})
+end
+
+function PANEL:SetRealAlpha(alpha)
+	self.realAlpha = alpha
+end
+
+function PANEL:OnMessageSent()
+	if self.phonePage ~= "chat" then return end
+	local text = self.entry:GetText()
+	if ZCChatThreads.Send(self,text) then return end
+	if ZCChatAssist and not ZCChatAssist.AllowSend(self.entry, true) then return end
+
+	if (text:find("%S")) then
+		local lastEntry = hg.chat.messageHistory[#hg.chat.messageHistory]
+
+		-- only add line to textentry history if it isn't the same message
+		if (lastEntry != text) then
+			if (#hg.chat.messageHistory >= 20) then
+				table.remove(hg.chat.messageHistory, 1)
+			end
+
+			hg.chat.messageHistory[#hg.chat.messageHistory + 1] = text
+		end
+
+		net.Start("zChatMessage")
+			net.WriteString(text)
+			net.WriteUInt(self.ZCReplyID or 0, 32)
+		net.SendToServer()
+		self.ZCReplyID = nil
+	end
+
+	self:SetActive(false, true)
+end
+
+function PANEL:ShowSystemBanner(elements)
+	if self.bannerMuted then return end
+	local parts = {}
+	for _, value in ipairs(elements) do
+		if isstring(value) or isnumber(value) then parts[#parts + 1] = tostring(value) end
+		if type(value) == "Player" and IsValid(value) then parts[#parts + 1] = value:Nick() end
+	end
+	local message = string.Trim(table.concat(parts))
+	if message == "" then return end
+	if ZCChatThreads and ZCChatThreads.PlayNotification then ZCChatThreads.PlayNotification("main") end
+	while #self.bannerNotices >= 3 do
+		local oldest = table.remove(self.bannerNotices, 1)
+		if IsValid(oldest) then oldest:Remove() end
+	end
+	local banner = vgui.Create("DPanel")
+	self.bannerNotices[#self.bannerNotices + 1] = banner
+	banner.ZCMessage = message
+	banner:SetMouseInputEnabled(false)
+	banner:SetKeyboardInputEnabled(false)
+	banner:SetSize(math.max(120, self:GetWide() - 64), 32)
+	self:LayoutSystemBanners()
+	banner:SetTooltip(message)
+	banner:MoveToFront()
+	if IsValid(self.bannerMuteButton) then self.bannerMuteButton:MoveToFront() end
+	local started = CurTime()
+	banner.Paint = function(panel, w, h)
+		local elapsed = CurTime() - started
+		local alpha = 255 * math.min(math.Clamp(elapsed / 0.18, 0, 1), math.Clamp((3.5 - elapsed) / 0.25, 0, 1))
+		draw.RoundedBox(0, 0, 0, w, h, Color(32, 32, 36, alpha * 0.96))
+		for i, line in ipairs(panel.ZCLines or {}) do
+			draw.SimpleText(line, "DermaDefaultBold", 12, 7 + (i - 1) * 16,
+				Color(243, 240, 240, alpha), TEXT_ALIGN_LEFT)
+		end
+	end
+	banner.Think = function(panel)
+		if CurTime() - started < 3.5 then return end
+		panel:Remove()
+		for i, notice in ipairs(self.bannerNotices) do
+			if notice == panel then table.remove(self.bannerNotices, i) break end
+		end
+		self:LayoutSystemBanners()
+	end
+end
+
+function PANEL:AppendConversationLine(elements, restored)
+	local speaker = IsValid(CHAT_SPEAKER) and CHAT_SPEAKER or nil
+	-- Owner 2026-09-24 (late): organism notifications (sh_notification.lua echoes them with hg.NotificationEchoing set)
+	-- stay plain chat lines - never the system banner, which GoobOS turns into a push notification.
+	local organism = hg and hg.NotificationEchoing == true
+	if not speaker and not CHAT_IS_BOT and not CHAT_PRIVATE and not restored and not organism then
+		self:ShowSystemBanner(elements)
+		return
+	end
+	if self.phonePage ~= "chat" and self:GetActive() then
+		self.phoneUnread = (self.phoneUnread or 0) + 1
+	end
+	local buffer = {
+		"<font=zChatFont>"
+	}
+
+	buffer = hook.Run("ModifyMessageBuffer", buffer, CHAT_SPEAKER) or buffer
+
+	if speaker and speaker:IsBot() then
+		for i, value in ipairs(elements) do
+			if isstring(value) and value == speaker:Nick() then elements[i] = speaker; break end
+		end
+	end
+	local arrived = restored and restored.arrived or RealTime()
+	local chainKey = restored and (restored.key or ("legacy:" .. tostring(restored.id or #self.entries))) or CHAT_SENDER_STEAM or ZCChatMedia.ChainKey(speaker)
+	if restored and chainKey then chainKey = chainKey:gsub(":alive.*$", ""):gsub(":dead.*$", "") end
+	local position, grouped = ZCChatMedia.ChainPosition(self.entries, chainKey, arrived)
+	if restored then position = #self.entries + 1 end
+	local identity = ZCChatMedia.CaptureIdentity(elements, speaker, restored and restored.steam or CHAT_SENDER_STEAM,
+        restored and restored.name or CHAT_SENDER_NAME)
+	elements.zcTimestamp = elements.zcTimestamp or (os.time() - math.max(0, math.floor(RealTime() - arrived)))
+	local fullElements = {}
+	for i, value in pairs(elements) do fullElements[i] = value end
+	fullElements.zcGrouped = false
+	if restored then ZCChatMedia.Verdicts[fullElements] = restored.verdict or (restored.mediaAllowed and "allow" or "hidden") end
+	elements.zcGrouped = true
+	local fullDisplay = ZCChatMedia.DisplayElements(fullElements)
+	ZCChatMedia.Verdicts[elements] = ZCChatMedia.Verdicts[fullElements]
+	local display, gifURL = ZCChatMedia.DisplayElements(elements)
+	local function format(items, parts)
+	for _, v in ipairs(items) do
+		if istable(v) and v.zcIdentityHeader then
+                parts[#parts + 1] = ZCChatMedia.IdentityMarkup(v.zcIdentityHeader)
+		elseif (type(v) == "IMaterial") then
+			local texture = v:GetName()
+
+			if (texture) then
+				parts[#parts + 1] = string.format("<img=%s,%dx%d> ", texture, v:Width(), v:Height())
+			end
+		elseif (istable(v) and v.r and v.g and v.b) then
+			parts[#parts + 1] = string.format("<color=%d,%d,%d>", v.r, v.g, v.b)
+		elseif (type(v) == "Player" and IsValid(v)) then
+			local color = team.GetColor(v:Team())
+
+			parts[#parts + 1] = string.format("<color=%d,%d,%d>%s", color.r, color.g, color.b,
+				v:GetName():gsub("<", "&lt;"):gsub(">", "&gt;"))
+		else
+			parts[#parts + 1] = ZCChatMedia.Format(tostring(v), 22)
+		end
+	end
+
+		return table.concat(parts)
+	end
+	local originalText, fullOriginal, groupedOriginal
+	if gifURL then
+		local originalBuffer = {}
+		for i, value in ipairs(buffer) do originalBuffer[i] = value end
+		originalText = format(elements, originalBuffer)
+		local fullParts, groupParts = {}, {}
+		for i, value in ipairs(buffer) do fullParts[i] = value; groupParts[i] = value end
+		fullOriginal = format(ZCChatMedia.SocialElements(fullElements), fullParts)
+		groupedOriginal = format(ZCChatMedia.SocialElements(elements), groupParts)
+	end
+	local fullBuffer = {}
+	for i, value in ipairs(buffer) do fullBuffer[i] = value end
+	local fullText = format(fullDisplay, fullBuffer)
+	local groupedText = format(display, buffer)
+	local displayText = grouped and groupedText or fullText
+	if restored and not identity then
+		fullText = restored.full or restored.text
+		groupedText = restored.grouped or restored.text
+		-- Migrate already-rendered dead headers from earlier previews too.
+		if elements[2] == ":skull: " then
+			local header = "<color=255,0,0>" .. ZCChatMedia.Format(":skull: ", 18)
+			groupedText = groupedText:gsub(ZCChatMedia.Pattern(header), "<color=255,0,0>", 1)
+		end
+		displayText = restored.text
+	end
+
+	local panel = self.history:Add("zChatMessage")
+	panel.ZCHasInlineMedia = gifURL ~= nil
+	panel.ZCMessageID = tonumber(CHAT_MESSAGE_ID)
+	if panel.ZCMessageID and ZCChatMedia.DeletedIDs and ZCChatMedia.DeletedIDs[panel.ZCMessageID] then panel:Remove(); return end
+	panel.ZCSpeaker = speaker
+	panel.ZCSenderName = restored and restored.name or CHAT_SENDER_NAME or (speaker and speaker:Nick())
+	panel.ZCSenderSteam = restored and restored.steam or CHAT_SENDER_STEAM or (speaker and not speaker:IsBot() and speaker:SteamID64())
+	panel.ZCConversation = CHAT_CONVERSATION or "main"
+	panel.ZCSourceElements = elements
+	panel.ZCChainKey, panel.ZCArrived = chainKey, arrived
+	panel.ZCFullText, panel.ZCGroupedText = fullText, groupedText
+	panel.ZCReplyID = tonumber(CHAT_REPLY_ID)
+	local previous = self.entries[#self.entries]
+	if IsValid(previous) and previous.ZCSpeaker ~= speaker then
+		panel.ZCTopGap = 12
+		panel:DockMargin(0, panel.ZCTopGap, 0, 0)
+	end
+	if speaker or CHAT_IS_BOT or CHAT_PRIVATE or (restored and (restored.bubble or (restored.id and restored.id > 0))) then
+		panel.ZCBubble = true
+		panel.ZCBot = (speaker and speaker:IsBot()) or CHAT_IS_BOT or (restored and restored.bot) or false
+	end
+	if speaker or panel.ZCSenderSteam or panel.ZCBot then
+		panel.ZCOwn = speaker == LocalPlayer() or panel.ZCSenderSteam == LocalPlayer():SteamID64() or (restored and restored.own)
+		panel.ZCLeftInset = (ZCPhoneSettings and ZCPhoneSettings.AvatarSize() or 40)+8
+		panel.ZCAvatar = panel:Add("AvatarImage")
+		panel.ZCAvatar:SetPos(0, 0)
+		panel.ZCAvatar:SetSize((ZCPhoneSettings and ZCPhoneSettings.AvatarSize() or 40), (ZCPhoneSettings and ZCPhoneSettings.AvatarSize() or 40))
+		if panel.ZCBot then
+			panel.ZCAvatar.Paint = function(s, w, h)
+				if ZCScoreboard and ZCScoreboard.Services and ZCScoreboard.Services.BotAvatar then
+					ZCScoreboard.Services.BotAvatar(w, h, panel.ZCSenderName or "")
+					return true
+				end
+			end
+		else
+			if speaker then panel.ZCAvatar:SetPlayer(speaker, 64) elseif panel.ZCSenderSteam and not panel.ZCSenderSteam:match("^bot:") then panel.ZCAvatar:SetSteamID(panel.ZCSenderSteam, 64) end
+		end
+		panel.ZCAvatar:SetMouseInputEnabled(false)
+        panel.ZCAvatar:SetTooltip(ZCChatMedia.IdentityTooltip(identity))
+	end
+	panel:Dock(TOP)
+	panel:InvalidateParent(true)
+	panel:SetMarkup(displayText)
+	panel.ZCGifOriginalText = restored and not identity and restored.original or originalText
+	panel.ZCFullOriginal = restored and not identity and restored.fullOriginal or fullOriginal
+	panel.ZCGroupedOriginal = restored and not identity and restored.groupedOriginal or groupedOriginal
+	ZCChatMedia.Attach(panel, elements)
+
+	if (#self.entries >= 500) then -- bounded scrollback (owner 2026-09-23), was 100
+		local oldPanel = table.remove(self.entries, 1)
+
+		if (IsValid(oldPanel)) then
+			oldPanel:Remove()
+		end
+	end
+
+	local bar = self.history:GetVBar()
+	local bScroll = !self:GetActive() or bar:GetScroll() >= (bar.CanvasSize or 0) - 8
+	if bScroll then
+		self.scrollFrom = bar:GetScroll()
+		self.scrollStart = CurTime()
+	end
+
+	table.insert(self.entries, math.min(position, #self.entries + 1), panel)
+	self:ZCWake()
+	ZCChatMedia.ReflowChains(self)
+	return panel
+end
+
+function PANEL:AddLine(elements,restored)
+	return ZCChatThreads.Append(self,elements,restored,self.AppendConversationLine)
+end
+
+function PANEL:AddMessage(...)
+	self:AddLine({...})
+end
+
+function PANEL:OnRemove()
+	if IsValid(self.keyOrb) then self.keyOrb:Remove() end
+	for _, notice in ipairs(self.bannerNotices or {}) do
+		if IsValid(notice) then notice:Remove() end
+	end
+end
+
+vgui.Register("zChatbox", PANEL, "EditablePanel")
