+	DisableClipping(true)
+		local clipX, clipY = hg.chat.history:LocalToScreen(0, 0)
+		local clipW, clipH = hg.chat.history:GetSize()
+
+		render.SetScissorRect(clipX, clipY, clipX + clipW, clipY + clipH, true)
+			if self.ZCBubble then
+				local bubbleAlpha = math.Clamp(newAlpha * ((ZCPhoneSettings and ZCPhoneSettings.Get("opacity") or 58) / 100), 0, 255)
+				local shade = self.ZCOwn and ZC_BUBBLE_OWN or ZC_BUBBLE_PEER
+				shade.a = bubbleAlpha
