+-- One palette for the whole chatbox. The old look inherited its colours from
+-- three unrelated places: a red gradient wash on the frame, a brown rect behind
+-- the entry, and white-on-black hint text. These are deliberate, and they are
+-- the only colours drawn here.
+local ZC_ACCENT = Color(192, 0, 0)
+local ZC_PANEL = Color(20, 17, 17, 214)
+local ZC_RULE = Color(255, 255, 255, 18)
+local ZC_ENTRY = Color(31, 28, 28)
+local ZC_HINT = Color(150, 150, 150)
+local ZC_SHADOW = Color(0, 0, 0, 200)
+local ZC_ENTRY_EDGE = Color(60, 56, 58, 230)
+local ZC_ENTRY_FILL = Color(31, 28, 28, 245)
+local ZC_FRAME_EDGE = Color(83, 19, 23)
+local ZC_FRAME_FILL = Color(20, 17, 17)
+local ZC_BUBBLE_OWN = Color(111, 32, 36)
+local ZC_BUBBLE_PEER = Color(48, 46, 49)
+
+surface.CreateFont("ZCPhoneClock", {font = "Roboto", size = 38, weight = 400, antialias = true})
+surface.CreateFont("ZCPhoneLabel", {font = "Roboto", size = 14, weight = 500, antialias = true})
+surface.CreateFont("ZCPhoneWordmark", {font = "Trebuchet MS", size = 19, weight = 900, antialias = true})
+
+local function PaintGoobOSWordmark(cx, cy)
+	surface.SetFont("ZCPhoneWordmark")
+	local goobWidth = surface.GetTextSize("Goob")
+	local osWidth = surface.GetTextSize("OS")
+	local textWidth = goobWidth + osWidth + 2
+	local left = cx - textWidth / 2
+	-- An inset badge and offset shadow make the wordmark part of the frame.
+	draw.RoundedBox(0, left - 15, cy - 14, textWidth + 30, 28, Color(19, 16, 16, 150))
+	draw.SimpleText("Goob", "ZCPhoneWordmark", left, cy + 1, Color(0, 0, 0, 180), TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
+	draw.SimpleText("Goob", "ZCPhoneWordmark", left, cy, Color(225, 225, 225), TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
+	draw.SimpleText("OS", "ZCPhoneWordmark", left + goobWidth + 2, cy, Color(199, 2, 2), TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
+	surface.SetDrawColor(150, 0, 0, 210)
+	local x1, x2 = left - 8, left + textWidth + 8
+	surface.DrawLine(x1 + 4, cy - 8, x1, cy - 8)
+	surface.DrawLine(x1, cy - 8, x1, cy + 8)
+	surface.DrawLine(x1, cy + 8, x1 + 4, cy + 8)
+	surface.DrawLine(x2 - 4, cy - 8, x2, cy - 8)
+	surface.DrawLine(x2, cy - 8, x2, cy + 8)
+	surface.DrawLine(x2, cy + 8, x2 - 4, cy + 8)
+end
+
+local function PhoneHover(button)
+	button.ZCHover = Lerp(math.Clamp(FrameTime() * 14, 0, 1), button.ZCHover or 0,
+		(button:IsHovered() or button:HasFocus()) and 1 or 0)
+	return button.ZCHover
+end
+
+local function ChatKeyLabel()
+	local key = input.LookupBinding("messagemode") or input.LookupBinding("messagemode2") or "KEY"
+	key = string.upper(key):gsub("MOUSE", "M"):gsub("KP_", "KP")
+	return #key > 4 and key:sub(1, 4) or key
+end
+
+local function WrapSystemBannerText(message, maxWidth, maxLines)
+	maxLines = maxLines or 4
+	surface.SetFont("DermaDefaultBold")
+	local lines, current = {}, ""
+	local function push()
+		lines[#lines + 1] = current
+		current = ""
+	end
+	for word in tostring(message):gsub("[\r\n]", " "):gmatch("%S+") do
+		local candidate = current == "" and word or (current .. " " .. word)
+		if surface.GetTextSize(candidate) <= maxWidth then
+			current = candidate
+		else
+			if current ~= "" then push() end
+			-- URLs and long names need character wrapping, without splitting UTF-8.
+			for index = 1, string.utf8len(word) do
+				local char = string.utf8sub(word, index, index)
+				if current ~= "" and surface.GetTextSize(current .. char) > maxWidth then push() end
+				current = current .. char
+			end
+		end
+	end
+	if current ~= "" then push() end
+	if #lines == 0 then lines[1] = "" end
+	if #lines > maxLines then
+		while #lines > maxLines do table.remove(lines) end
+		local last = lines[maxLines]
+		while last ~= "" and surface.GetTextSize(last .. "…") > maxWidth do
+			last = string.utf8sub(last, 1, string.utf8len(last) - 1)
+		end
+		lines[maxLines] = last .. "…"
+	end
+	return lines
+end
+
+local function CallbackBind(self, callback)
+	return function(_, ...)
+		return callback(self, ...)
+	end
+end
+
+local function PaintMarkupOverride(text, font, x, y, color, alignX, alignY, alpha)
+	alpha = alpha or 255
+
+	-- background for easier reading
+	surface.SetTextPos(x + 1, y + 1)
+	surface.SetTextColor(0, 0, 0, alpha)
+	surface.SetFont(font)
+	surface.DrawText(text)
+
+	surface.SetTextPos(x, y)
+	surface.SetTextColor(color.r, color.g, color.b, alpha)
+	surface.SetFont(font)
+	surface.DrawText(text)
+end
+
+local PANEL = {}
