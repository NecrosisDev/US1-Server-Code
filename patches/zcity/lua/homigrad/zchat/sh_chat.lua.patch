+local maxLength = CreateConVar("zchat_maxmessagelength", "256", {FCVAR_ARCHIVE, FCVAR_NOTIFY, FCVAR_REPLICATED}, "Maximum message length allowed")
+
+if CLIENT then
+	local fontSize = CreateClientConVar("zchat_fontsize", 7, true, false, "Self explanatory", 3, 10)
+	local fontName = CreateClientConVar("zchat_font", "Bahnschrift", true, false, "Self explanatory, should be available to GMod")
+	local fontAA = CreateClientConVar("zchat_fontaa", 1, true, false, "Font anti-aliasing", 0, 1)
+	local fontWeight = CreateClientConVar("zchat_fontweight", 1000, true, false, "Font weight", 0, 1000)
+
+	local function CreateChat()
+		local map = game.GetMap()
+		local saved = (not hg.ZChatMap or hg.ZChatMap == map) and ZCChatMedia and ZCChatMedia.CaptureHistory(hg.chat)
+		if IsValid(hg.chat) then hg.chat:Remove() end
+		hg.chat = vgui.Create("zChatbox")
+		hg.ZChatMap = map
+		if saved then ZCChatMedia.RestoreHistory(hg.chat, saved) end
+	end
+
+	hook.Add("InitPostEntity", "ZChat", function()
+		CreateChat()
+	end)
+
+	hook.Add("PlayerStartVoice", "RemoveVoicePanles", function(ply)
+    if not IsValid(ply) then return end
+    ply.IsSpeak=true
+    if isfunction(hg.ShouldSuppressVoicePanel) then return hg.ShouldSuppressVoicePanel(ply) end
+end)
+
+	-- CreateChat()
+
+	hook.Add("PlayerBindPress", "ZChat", function(client, bind, pressed)
+		bind = bind:lower()
+
+		if (bind:find("messagemode") and pressed) then
+			if not IsValid(hg.chat) then CreateChat() end
+			if not IsValid(hg.chat) then return end
+			hg.chat:SetActive(true)
+			if ZCChatThreads then ZCChatThreads.Select(hg.chat,"main") end
+
+			return true
+		end
+	end)
+
+	hook.Add("OnShowZCityPause", "ZChat", function()
+		if not IsValid(hg.chat) or not hg.chat:GetActive() then return end
+		hg.chat:SetActive(false)
+
+		return false
+	end)
+
+	hook.Add("HUDShouldDraw", "ZChat", function(name)
+		if (name == "CHudChat") then
+			return false
+		end
+	end)
+
+	net.Receive("zChatMessage", function(len)
+		local speaker = net.ReadEntity()
+		local text = net.ReadString()
+		local bWhisper = net.ReadBool()
+		local messageID = net.BytesLeft() >= 4 and net.ReadUInt(32) or 0
+
+		-- The speaker may have disconnected before this packet arrives.
+		if not IsValid(speaker) or not speaker:IsPlayer() then return end
+		speaker.ChatWhisper = bWhisper
+
+		CHAT_SPEAKER = speaker
+		CHAT_MESSAGE_ID = messageID
+		CHAT_REPLY_ID = net.BytesLeft() >= 4 and net.ReadUInt(32) or 0
+
+		local supressed = hook.Run("OnPlayerChat", speaker, text, false, speaker:Alive(), bWhisper)
+		if !supressed then
+			chat.AddText(speaker, ": ", text)
+		end
+
+		CHAT_SPEAKER = nil
+		CHAT_MESSAGE_ID = nil
+		CHAT_REPLY_ID = nil
+	end)
+
+	net.Receive("zChatGlobalMessage", function(len)
+		local buffer = net.ReadTable()
+		CHAT_MESSAGE_ID = buffer.zcMessageID
+		CHAT_SPEAKER = buffer.zcSpeakerIndex and Entity(buffer.zcSpeakerIndex) or nil
+		CHAT_IS_BOT = buffer.zcBot
+		chat.AddText(unpack(buffer))
+		CHAT_MESSAGE_ID = nil
+		CHAT_SPEAKER = nil
+		CHAT_IS_BOT = nil
+	end)
+
+	hook.Add("ChatText", "ZChat", function(index, name, text, messageType)
+		if (IsValid(hg.chat)) then
+			hg.chat:AddMessage(text)
+		end
+	end)
+
+	function chat.AddText(...)
+		if (IsValid(hg.chat)) then
+			hg.chat:AddMessage(...)
+		end
+
+		-- log chat message to console
+		local text = {}
+
+		for _, v in ipairs({...}) do
+			if (istable(v) or isstring(v)) then
+				text[#text + 1] = v
+			elseif (isentity(v) and IsValid(v) and v:IsPlayer()) then
+				text[#text + 1] = team.GetColor(v:Team())
+				text[#text + 1] = v:Name()
+			elseif (type(v) != "IMaterial") then
+				text[#text + 1] = tostring(v)
+			end
+		end
+
+		text[#text + 1] = "\n"
+		MsgC(unpack(text))
+	end
+
+	local function LoadFonts()
+		-- Keep chat readable at high resolutions without ScreenScale inflating every row.
+        -- The existing text-size setting still controls the full range.
+        local scale = math.Clamp(ScrW() / 1920, 0.9, 1.15)
+        local size = math.floor(fontSize:GetFloat() * 2.6 * scale + 0.5)
+		local font = fontName:GetString()
+		local fontAntiAliasing = fontAA:GetBool()
+		local fontW = fontWeight:GetFloat()
+
+		surface.CreateFont("zChatFont", {
+			font = font,
+			size = size,
+			extended = true,
+			weight = fontW,
+			antialias = fontAntiAliasing
+		})
+
+		surface.CreateFont("zChatFontSmall", {
+			font = font,
+			size = math.floor(12 * scale + 0.5),
+			extended = true,
+			weight = fontW,
+			antialias = fontAntiAliasing
+		})
+
+		surface.CreateFont("ZB_ProotOSChat", {
+			font = "Ari-W9500",
+			size = size,
+			extended = true,
+			weight = fontW,
+			antialias = fontAntiAliasing
+		})
+
+		surface.CreateFont("BerserkChatFont", {
+			font = "Who asks Satan",
+			size = size + 3,
+			extended = true,
+			weight = 0,
+			antialias = fontAntiAliasing
+		})
+	end
+
+    -- Old hotloads appended anonymous font callbacks. Retire only this owner's
+    -- callbacks and coalesce changes, preserving other addons' listeners.
+    for _,name in ipairs({"zchat_fontsize","zchat_font","zchat_fontaa","zchat_fontweight"})do
+        local callbacks=cvars.GetConVarCallbacks(name) or {}
+        for i=#callbacks,1,-1 do
+            local fn=callbacks[i]
+            if isfunction(fn) then
+                local source=(debug.getinfo(fn,"S").source or ""):gsub("^@","")
+                if source=="ZCChatGroupPreview/sh_chat.lua" or source=="GoobOSPublic/sh_chat.lua"
+                    or source=="homigrad/zchat/sh_chat.lua" or source:match("/homigrad/zchat/sh_chat%.lua$") then
+                    table.remove(callbacks,i)
+                end
+            end
+        end
+        cvars.AddChangeCallback(name,function()
+            timer.Create("ZChat.FontRefresh",.1,1,function()LoadFonts();CreateChat()end)
+        end,"ZChat.FontRefresh")
+    end
+
+	concommand.Add("zchat_reload", function()
+		LoadFonts()
+		CreateChat()
+	end)
+
+	LoadFonts()
+
+	hook.Add("ModifyMessageBuffer", "ChatFont", function(buffer, speaker)
+		if !IsValid(speaker) or !speaker:IsPlayer() then return end
+
+		if speaker.PlayerClassName == "furry" then
+			buffer[#buffer + 1] = "<font=ZB_ProotOSChat>"
+		elseif speaker:IsBerserk() then
+			buffer[#buffer + 1] = "<font=BerserkChatFont>"
+		end
+	end)
+
+	hook.Add("StartChat", "TypingBool", function()
+		net.Start("zChatTyping")
+			net.WriteBool(not ZCChatThreads or ZCChatThreads.IsMain(hg.chat))
+		net.SendToServer()
+	end)
+
+	hook.Add("FinishChat", "TypingBool", function()
+		net.Start("zChatTyping")
+			net.WriteBool(false)
+		net.SendToServer()
+	end)
+
+	local META = FindMetaTable("Player")
+
+	function META:IsTyping()
+		return self:GetNetVar("bIsTyping")
+	end
+
+	local ghost = Color(118, 159, 255)
+	local dead = Color(255, 0, 0)
+	hook.Add("OnPlayerChat", "ZChatDead", function(ply, text, bTeam, bDead, bWhisper)
+		if ( ply:IsPlayer() and !ply:Alive() ) then
+			chat.AddText( dead, ":skull: ", ghost, ply, ghost, ": "..text )
+			return true
+		end
+	end)
+else
+	function ZCChatReplyAllowed(ply, id)
+		local record = ZCChatModeration and ZCChatModeration.records[tonumber(id)]
+		return IsValid(ply) and record and (record.conversation or "main") == "main" and not record.deleted and record.viewers[ply:SteamID64()] == true or false
+	end
+	util.AddNetworkString("zChatMessage")
+	util.AddNetworkString("zChatGlobalMessage")
+	util.AddNetworkString("zChatTyping")
+
+	net.Receive("zChatMessage", function(len, ply)
+		local text = net.ReadString()
+		local replyID = net.BytesLeft() >= 4 and net.ReadUInt(32) or 0
+
+		local maxLen = maxLength:GetInt()
+
+		if (text:utf8len() > maxLen) then
+			text = text:utf8sub(0, maxLen)
+		end
+
+		ply.ZCChatPendingReply = ZCChatReplyAllowed(ply, replyID) and replyID or nil
+		local ok, err = pcall(hook.Run, "PlayerSay", ply, text)
+		ply.ZCChatPendingReply = nil
+		if not ok then ErrorNoHalt(tostring(err).."\n") end
+	end)
+
+	-- Dead/spectator recipients get the clean, pre-scramble text (owner request
+	-- 2026-09-23); living recipients keep exactly the organism-scrambled text
+	-- HG_PlayerSay produces. Mirrors sv_zc_chat_groups.lua's G.Spectator predicate.
+	local function ZChatIsSpectating(p)
+		return not p:Alive() or p:Team() == TEAM_SPECTATOR
+	end
+
+	hook.Add("PlayerSay", "ZChat", function(ply, text)
+		-- ChatGuard hides links that do not embed (zc_chatguard_hidelinks) here, before the copy spectators get is
+		-- kept, so nobody receives them. Fails open; "" = nothing left to send.
+		if ZCChatGuard and ZCChatGuard.FilterLinks then local ok, shown = pcall(ZCChatGuard.FilterLinks, ply, text, "") if ok and isstring(shown) then if shown == "" then return "" end text = shown end end
+ 		local cleanText = text
+		local txtTbl = {text}
+		hook.Run("HG_PlayerSay", ply, txtTbl, text) // our shit gets called later
+		text = isstring(txtTbl[1]) and txtTbl[1] or text // checks to see if shit hits the ceiling
+
+		if text == "" then return end
+
+		if ply:Alive() and ply.organism and ply.organism.otrub then return end
+
+		ply.ChatWhisper = ply:Alive() and ply.ChatWhisper or false
+
+		local rf = RecipientFilter()
+		local recipients = {}
+		-- local checkdist = ply.ChatWhisper and 128 * 128 or 1024 * 1024
+		for i, plya in player.Iterator() do
+			if plya:Alive() and plya.organism and plya.organism.otrub then continue end
+			if plya:Alive() and !ply:Alive() then continue end
+
+			if (hook.Run("PlayerCanSeePlayersChat", text, false, plya, ply)) then
+				rf:AddPlayer(plya)
+				recipients[#recipients + 1] = plya
+			end
+		end
+		local messageID = ZCChatReaction_Register and ZCChatReaction_Register(ply, recipients) or 0
+		
+		-- Quote IDs are scoped to both the sender and each original viewer.
+		-- No raw quote text crosses the wire (hearing and privacy stay intact).
+		for _, recipient in ipairs(recipients) do
+			local replyID = ply.ZCChatPendingReply or 0
+			if not ZCChatReplyAllowed(recipient, replyID) then replyID = 0 end
+			-- Dead/spectator recipients hear the clean, undistorted line; living
+			-- recipients keep the speaker's organism-scrambled text unchanged.
+			local sendText = ZChatIsSpectating(recipient) and cleanText or text
+			net.Start("zChatMessage")
+			net.WriteEntity(ply)
+			net.WriteString(sendText)
+			net.WriteBool(ply.ChatWhisper)
+			net.WriteUInt(messageID, 32)
+			net.WriteUInt(replyID, 32)
+			net.Send(recipient)
+		end
+
+		-- log chat message to console
+		local textConsole = {}
+
+		textConsole[#textConsole + 1] = ply:GetPlayerColor():ToColor()
+		textConsole[#textConsole + 1] = ply:GetNWString("PlayerName", ply:Nick())
+		textConsole[#textConsole + 1] = color_white
+		textConsole[#textConsole + 1] = ": " .. text
+
+		textConsole[#textConsole + 1] = "\n"
+
+		MsgC(unpack(textConsole))
+
+		hook.Run("PostPlayerSay", client, chatType, text)
+		return ""
+	end)
+
+	net.Receive("zChatTyping", function(len, ply)
+		ply:SetNetVar("bIsTyping", net.ReadBool())
+	end)
+
+	local META = FindMetaTable("Player")
+
+	function META:IsTyping()
+		return self:GetNetVar("bIsTyping")
+	end
+
+	function META:zChatPrint(...)
+		net.Start("zChatGlobalMessage")
+			net.WriteTable({...})
+		net.Send(self)
+	end
+
+	function META:zChatPrintMeta(messageID, speaker, ...)
+		local buffer = {...}
+		buffer.zcMessageID = messageID
+		buffer.zcSpeakerIndex = IsValid(speaker) and speaker:EntIndex() or nil
+		buffer.zcBot = IsValid(speaker) and speaker:IsBot() or false
+		net.Start("zChatGlobalMessage")
+			net.WriteTable(buffer)
+		net.Send(self)
+	end
+
+	function zChatPrint(...)
+		net.Start("zChatGlobalMessage")
+			net.WriteTable({...})
+		net.Broadcast()
+	end
+end
