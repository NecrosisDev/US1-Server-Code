+-- Only NoHolster weapons matter here, and NoHolster is a class-level SWEP flag. ply:GetWeapons() allocates a table per call,
+-- so skip the scan while the last one found no such weapon. WeaponEquip re-arms it; the 5 s rescan is the safety net for any
+-- acquisition path that does not fire WeaponEquip.
+hook.Add("WeaponEquip", "homigrad-dropholstered", function(wep, ply)
+	if wep.NoHolster and IsValid(ply) then ply.hgNoHolsterScan = nil end
+end)
