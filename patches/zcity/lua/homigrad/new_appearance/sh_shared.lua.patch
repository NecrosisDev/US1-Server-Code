+-- Root cause of "Save always fails after Shuffle": AppAddModel's submatSlots (main/pants/boots/
+-- hands) is 4 keys wide, but the AClothes validator below used to cap at a stale 3, rejecting any
+-- draft that had actually filled the hands slot too. Derived from the same PlayerModels catalog so
+-- a future model with a different slot count can never drift from what this validator accepts.
+local function MaxClothesSlots()
+	local maxSlots = 0
+	for sex = 1, 2 do
+		for _, data in pairs(PlayerModels[sex] or {}) do
+			local count = table.Count(data.submatSlots or {})
+			if count > maxSlots then maxSlots = count end
+		end
+	end
+	return maxSlots
+end
+
+local CLOTHES_SLOT_CAP = MaxClothesSlots()
+
