+			if LocalPlayer().organism.otrub or not LocalPlayer():Alive() then self:Remove() return end
+			if (ent:GetPos() - LocalPlayer():GetPos()):LengthSqr() > 125^2 then self:Remove() return end
+			if ent:IsPlayer() and not IsValid(ent.FakeRagdoll) then self:Remove() return end
+			if input.IsKeyDown(KEY_R) then
+				self:Close()
+			end
+			-- T takes everything identified so far (not while typing somewhere).
+			local tDown = input.IsKeyDown(KEY_T) and not IsValid(vgui.GetKeyboardFocus())
+			if tDown and not self.tWasDown then takeAll() end
+			self.tWasDown = tDown
+
+			local now = RealTime() - t0
+			local found, shown, scan = 0, 0, 0
+			for idx = 1, total do
+				local e = entries[idx]
+				if now >= e.appearAt then shown = shown + 1 end
+				if now >= e.foundAt then
+					found = found + 1
+					if not e.revealed then
+						e.revealed = true
+						ent.foundloot[e.key] = true
+						if not e.known then
+							e.flashAt = RealTime()
+							surface.PlaySound("arc9_eft_shared/generic_mag_pouch_in" .. math.random(7) .. ".ogg")
+						end
+					end
+				elseif now >= e.scanAt then
+					scan = (now - e.scanAt) / math.max(e.foundAt - e.scanAt, 0.001)
+				end
+			end
+			self.now, self.found, self.shown, self.scan = now, found, shown, scan
+
+			local rt = RealTime()
+			if queue[1] and rt >= nextSendAt then
+				local e = table.remove(queue, 1)
+				if e.pending and not e.taken and not e.gone then
+					if istable(e.thing) then e.thing["render"] = {} end
+					takeSeq = takeSeq % 65535 + 1
+					e.seq = takeSeq
+					TakeItem(e.tab, e.key, e.thing, ent, takeSeq)
+					e.sentAt, nextSendAt = rt, rt + SEND_GAP
+				end
+			end
+			for idx = 1, total do
+				local e = entries[idx]
+				if e.pending and e.sentAt and rt - e.sentAt > TIMEOUT then
+					e.pending, e.sentAt, e.seq = false, nil, nil
+					toast("No answer from the server. Try again.")
+				end
+			end
+		end
+
+		local countKey, countStr, statusStr
+		frame.Paint = function(self, w, h)
+			if hg and isfunction(hg.DrawBlur) then hg.DrawBlur(self, 2) end
+			card(0, 0, w, h, C.glass, C.edge, 6)
+
+			local now = self.now
+			local done = now >= doneAt
+			local remaining = total - taken - gone
+
+			-- Count + status (strings rebuilt only when they change).
+			local dotN = 1 + math.floor(now * 2.5) % 3
+			local counting = now < countEnd
+			local c = countKey
+			if not c or c[1] ~= done or c[2] ~= self.found or c[3] ~= self.shown or c[4] ~= remaining or c[5] ~= dotN or c[6] ~= counting then
+				countKey = {done, self.found, self.shown, remaining, dotN, counting}
+				if done then
+					countStr = remaining == 0 and "Empty" or (remaining .. (remaining == 1 and " item" or " items"))
+					statusStr = total == 0 and "Nothing found" or "Search complete"
+				else
+					countStr = self.found .. " / " .. self.shown
+					statusStr = (now < countEnd and "Checking" or "Searching") .. DOTS[dotN]
+				end
+			end
+			surface.SetFont("ZCLoot.Count")
+			local countW = math.max(surface.GetTextSize(countStr), math.floor(92 * s))
+			draw.SimpleText(countStr, "ZCLoot.Count", w - pad, topY + u2, done and C.text or C.gold, TEXT_ALIGN_RIGHT, TEXT_ALIGN_TOP)
+			draw.SimpleText(statusStr, "ZCLoot.Status", w - pad, topY + sheetH - u4, C.muted, TEXT_ALIGN_RIGHT, TEXT_ALIGN_BOTTOM)
+
+			-- Identity sheet (bodies) or container plate.
+			local leftW = w - pad * 2 - countW - math.floor(12 * s)
+			if isBody then
+				card(pad, topY, leftW, sheetH, C.sheet, C.edge)
+				draw.RoundedBoxEx(4, pad + 1, topY + 1, u4, sheetH - 2, stripe, true, false, true, false)
+				local tx = pad + u4 + math.floor(10 * s)
+				draw.SimpleText("BODY", "ZCLoot.Caps", tx, topY + u6, C.muted)
+				if self.titleW ~= leftW then self.titleW, self.titleFit = leftW, fitText(title, "ZCLoot.Title", leftW - (tx - pad) - u8) end
+				draw.SimpleText(self.titleFit, "ZCLoot.Title", tx, topY + sheetH - u4, C.text, TEXT_ALIGN_LEFT, TEXT_ALIGN_BOTTOM)
+			else
+				local ps = math.floor(36 * s)
+				local py = topY + math.floor((sheetH - ps) / 2)
+				draw.RoundedBox(4, pad, py, ps, ps, C.plate)
+				surface.SetDrawColor(C.pink)
+				surface.DrawOutlinedRect(pad + math.floor(ps * 0.25), py + math.floor(ps * 0.3), math.floor(ps * 0.5), math.floor(ps * 0.45), math.max(1, math.floor(2 * s)))
+				local tx = pad + ps + math.floor(12 * s)
+				draw.SimpleText("CONTAINER", "ZCLoot.Caps", tx, topY + u6, C.muted)
+				if self.titleW ~= leftW then self.titleW, self.titleFit = leftW, fitText(title, "ZCLoot.Title", leftW - (tx - pad)) end
+				draw.SimpleText(self.titleFit, "ZCLoot.Title", tx, topY + sheetH - u4, C.text, TEXT_ALIGN_LEFT, TEXT_ALIGN_BOTTOM)
+			end
+
+			-- Progress bar.
+			local barW = w - pad * 2
+			local frac = done and 1 or (total > 0 and math.Clamp((self.found + self.scan) / total, 0, 1) or 0)
+			draw.RoundedBox(2, pad, barY, barW, barH, C.line)
+			if frac > 0 then draw.RoundedBox(2, pad, barY, math.max(barH, math.floor(barW * frac)), barH, done and C.edge or C.accent) end
+
+			-- Empty state.
+			if total == 0 and done then
+				local cy = gridTop + math.floor((h - gridTop - footH) / 2)
+				draw.SimpleText("Nothing inside", "ZCLoot.Empty", w / 2, cy - u2, C.muted, TEXT_ALIGN_CENTER, TEXT_ALIGN_BOTTOM)
+				draw.SimpleText("Already picked clean", "ZCLoot.Key", w / 2, cy + u2, C.dim, TEXT_ALIGN_CENTER, TEXT_ALIGN_TOP)
+			end
+		end
+
+		-- Footer: key hints; the R chip is also a close button for mouse users.
+		local footer = vgui.Create("DPanel", frame)
+		footer:Dock(BOTTOM)
+		footer:SetTall(footH)
+		footer:DockMargin(pad, 0, pad, u6)
+		local function keyChip(x, cy, key, label)
+			surface.SetFont("ZCLoot.Key")
+			local kw = surface.GetTextSize(key) + u4 * 2 + 2
+			local kh = math.floor(16 * s)
+			card(x, cy - kh / 2, kw, kh, C.chip, C.edge, 3)
+			draw.SimpleText(key, "ZCLoot.Key", x + kw / 2, cy, C.text, TEXT_ALIGN_CENTER, TEXT_ALIGN_CENTER)
+			local lw = surface.GetTextSize(label)
+			draw.SimpleText(label, "ZCLoot.Key", x + kw + u4, cy, C.muted, TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
+			return x + kw + u4 + lw + math.floor(14 * s)
+		end
+		local closeChip = vgui.Create("DButton", footer)
+		closeChip:SetText("")
+		closeChip:Dock(LEFT)
+		closeChip:SetWide(math.floor(64 * s))
+		closeChip.Paint = function(self, w, h) keyChip(0, h / 2, "R", self:IsHovered() and "Close" or "Close") end
+		closeChip.DoClick = function() if IsValid(frame) then frame:Close() end end
+		local takeAllChip = vgui.Create("DButton", footer)
+		takeAllChip:SetText("")
+		takeAllChip:Dock(RIGHT)
+		takeAllChip:SetWide(math.floor(92 * s))
+		takeAllChip.Paint = function(self, w, h)
+			surface.SetFont("ZCLoot.Key")
+			local lw = surface.GetTextSize("Take all")
+			local kw = surface.GetTextSize("T") + u4 * 2 + 2
+			keyChip(w - lw - kw - u4, h / 2, "T", "Take all")
+		end
+		takeAllChip.DoClick = function() takeAll() end
+		footer.Paint = function(self, w, h)
+			local cy = h / 2
+			if frame.toastText and RealTime() < frame.toastUntil then
+				local x0 = closeChip:GetWide()
+				if self.toastFor ~= frame.toastText or self.toastW ~= w then
+					self.toastFor, self.toastW = frame.toastText, w
+					self.toastFit = fitText(frame.toastText, "ZCLoot.Key", w - x0 - u8)
+				end
+				draw.SimpleText(self.toastFit, "ZCLoot.Key", w, cy, C.pink, TEXT_ALIGN_RIGHT, TEXT_ALIGN_CENTER)
+			else
+				local x = keyChip(closeChip:GetWide(), cy, "LMB", "Take")
+				keyChip(x, cy, "RMB", "Item menu")
+			end
+		end
+
+		-- Grid.
+		local scroll = vgui.Create("DScrollPanel", frame)
+		scroll:Dock(FILL)
+		scroll:DockMargin(pad, gridTop, pad - 2, u4)
+		local sbar = scroll:GetVBar()
+		sbar:SetHideButtons(true)
+		sbar:SetWide(sbarW)
+		sbar.Paint = function(self, w, h) draw.RoundedBox(2, 0, 0, w, h, C.track) end
+		sbar.btnGrip.Paint = function(self, w, h) draw.RoundedBox(2, 0, 0, w, h, self:IsHovered() and C.accent or C.main) end
+
+		local layout = scroll:Add("DIconLayout")
+		layout:Dock(TOP)
+		layout:SetSpaceX(gap)
+		layout:SetSpaceY(gap)
+
+		for idx = 1, total do
+			local e = entries[idx]
+			local i, tab, thing = e.key, e.tab, e.thing
+			local name = nameThings(i, thing)
+			local iconLooked, Icon, HaveIcon, Overide, Quad = false, nil, nil, nil, nil
+			local text = (tab == "Ammo" and game.GetAmmoName(name)) or language.GetPhrase(name)
+			local sub = SUBLABEL[tab] or tab
+			e.qty = (tab == "Ammo" and isnumber(thing)) and ("x" .. thing) or nil
+
+			local button = layout:Add("DButton")
+			button:SetText("")
+			button:SetSize(tileW, tileH)
+
+			local function isFound() return (frame.now or 0) >= e.foundAt end
+			local function usable() return isFound() and not e.taken and not e.gone and not e.pending end
+
+			button.OnCursorEntered = function()
+				if not usable() then return end
+				if soundKD < CurTime() then
+					surface.PlaySound("arc9_eft_shared/generic_mag_pouch_out" .. math.random(7) .. ".ogg")
+					soundKD = CurTime() + 0.1
+				end
+			end
+
+			button.DoClick = function()
+				if not usable() then return end
+				if not functions[tab](ply, ent, i, unpack(e.thing1)) then
+					local OptionsMenu = DermaMenu()
+						OptionsMenu:AddOption( "You have item like this", function() end )
+					styleMenu(OptionsMenu)
+					OptionsMenu:Open()
+					return
+				end
+				surface.PlaySound("arc9_eft_shared/generic_mag_pouch_in" .. math.random(7) .. ".ogg")
+				soundKD = CurTime() + 0.2
+				request(e)
+			end
+
+			button.DoRightClick = function()
+				if not usable() then return end
+				if not functions[tab](ply, ent, i, unpack(e.thing1)) then
+					local OptionsMenu = DermaMenu()
+						OptionsMenu:AddOption( "You have item like this", function() end )
+					styleMenu(OptionsMenu)
+					OptionsMenu:Open()
+					return
+				end
+				local OptionsMenu = DermaMenu()
+					OptionsMenu:AddOption( "Take", function()
+						if not usable() then return end
+						surface.PlaySound("arc9_eft_shared/generic_mag_pouch_in" .. math.random(7) .. ".ogg")
+						soundKD = CurTime() + 0.2
+						request(e)
+					end )
+					OptionsMenu:AddOption( "Cancel", function() end )
+				styleMenu(OptionsMenu)
+				OptionsMenu:Open()
+			end
+
+			local paintTile
+			button.Paint = function(self, w, h)
+				-- Protected so a draw error can never leave the alpha multiplier stuck for the rest of the frame.
+				local ok, err = pcall(paintTile, self, w, h)
+				surface.SetAlphaMultiplier(1)
+				if not ok and not self.paintErr then self.paintErr = true ErrorNoHalt("[loot panel] tile paint: " .. tostring(err) .. "\n") end
+			end
+			paintTile = function(self, w, h)
+				local now = frame.now or 0
+				if now < e.appearAt then return end
+				local reduce = reducedMotion()
+				local a = reduce and 1 or math.Clamp((now - e.appearAt) / 0.18, 0, 1)
+				if e.taken or e.gone then a = a * 0.45 end
+				surface.SetAlphaMultiplier(a)
+				local dy = reduce and 0 or math.floor((1 - a) * u6)
+
+				if e.taken or e.gone then
+					card(0, dy, w, h, C.slot, C.slotEdge)
+					draw.SimpleText(e.taken and "TAKEN" or "GONE", "ZCLoot.Caps", w / 2, dy + h / 2, C.dim, TEXT_ALIGN_CENTER, TEXT_ALIGN_CENTER)
+				elseif now >= e.foundAt then
+					local hovered = self:IsHovered()
+					local edge = hovered and C.main or (e.rare and C.gold or C.edge)
+					card(0, dy, w, h, hovered and C.hover or C.card, edge)
+					if e.flashAt and not reduce then
+						local f = 1 - (RealTime() - e.flashAt) / 0.35
+						if f > 0 then
+							C.flash.a = math.floor(110 * f)
+							draw.RoundedBox(4, 1, dy + 1, w - 2, h - 2, C.flash)
+						end
+					end
+
+					-- Icon area: same icon sources as before, fitted into the top of the tile.
+					local bx, by, bw, bh = u6, dy + u6, w - u6 * 2, h - math.floor(40 * s)
+					if not iconLooked then
+						iconLooked = true
+						Icon, HaveIcon, Overide, Quad = getIconThing(i, thing, tab)
+					end
+					if Icon then
+						self.Icon = self.Icon or (isstring(Icon) and Material(Icon)) or Icon
+					end
+					if HaveIcon and self.Icon then
+						if Overide and isnumber(Icon) then
+							surface.SetTexture(self.Icon)
+						else
+							surface.SetMaterial(self.Icon)
+						end
+						surface.SetDrawColor(255, 255, 255)
+						if Quad then
+							local side = math.min(bw, bh)
+							surface.DrawTexturedRect(bx + (bw - side) / 2, by, side, side)
+						else
+							surface.DrawTexturedRect(bx, by, bw, bh)
+						end
+					elseif tab == "Ammo" then
+						local rw, rh = math.floor(bh * 0.18), math.floor(bh * 0.7)
+						local cx = bx + bw / 2
+						for k = -1, 1 do
+							draw.RoundedBox(math.floor(rw / 2), cx + k * rw * 1.7 - rw / 2, by + (bh - rh) / 2, rw, rh, C.text)
+						end
+					end
+
+					if self.textW ~= w then
+						self.textW, self.textFit = w, fitText(text, "ZCLoot.Name", w - u6 * 2)
+						self:SetTooltip(self.textFit ~= text and text or false)
+					end
+					draw.SimpleText(self.textFit, "ZCLoot.Name", w / 2, dy + h - math.floor(20 * s), C.text, TEXT_ALIGN_CENTER, TEXT_ALIGN_BOTTOM)
+					draw.SimpleText(sub, "ZCLoot.Sub", w / 2, dy + h - math.floor(7 * s), C.muted, TEXT_ALIGN_CENTER, TEXT_ALIGN_BOTTOM)
+
+					local qty = e.qty
+					if qty then
+						surface.SetFont("ZCLoot.Chip")
+						local qw = surface.GetTextSize(qty) + u8
+						card(w - qw - u4, dy + u4, qw, math.floor(14 * s), C.chip, C.edge, 3)
+						draw.SimpleText(qty, "ZCLoot.Chip", w - qw / 2 - u4, dy + u4 + math.floor(7 * s), C.text, TEXT_ALIGN_CENTER, TEXT_ALIGN_CENTER)
+					end
+					if e.rare then
+						surface.SetFont("ZCLoot.Chip")
+						local rw = surface.GetTextSize("RARE") + u8
+						card(u4, dy + u4, rw, math.floor(14 * s), C.chip, C.gold, 3)
+						draw.SimpleText("RARE", "ZCLoot.Chip", u4 + rw / 2, dy + u4 + math.floor(7 * s), C.gold, TEXT_ALIGN_CENTER, TEXT_ALIGN_CENTER)
+					end
+					if e.pending then
+						draw.RoundedBox(4, 1, dy + 1, w - 2, h - 2, C.veil)
+						draw.SimpleText("TAKING", "ZCLoot.Caps", w / 2, dy + h / 2, C.text, TEXT_ALIGN_CENTER, TEXT_ALIGN_CENTER)
+					end
+				else
+					local scanning = now >= e.scanAt
+					card(0, dy, w, h, C.slot, scanning and C.main or C.slotEdge)
+					local col = scanning and C.muted or C.dim
+					draw.SimpleText("?", "ZCLoot.Q", w / 2, dy + h * 0.44, col, TEXT_ALIGN_CENTER, TEXT_ALIGN_CENTER)
+					draw.SimpleText(scanning and "SEARCHING" or "UNKNOWN", "ZCLoot.Caps", w / 2, dy + h * 0.72, col, TEXT_ALIGN_CENTER, TEXT_ALIGN_CENTER)
+					local bh3 = math.max(2, math.floor(3 * s))
+					draw.RoundedBox(0, 1, dy + h - bh3 - 1, w - 2, bh3, C.track)
+					if scanning then
+						local f = math.Clamp((now - e.scanAt) / math.max(e.foundAt - e.scanAt, 0.001), 0, 1)
+						draw.RoundedBox(0, 1, dy + h - bh3 - 1, math.floor((w - 2) * f), bh3, C.accent)
+					end
+				end
+				surface.SetAlphaMultiplier(1)
+			end
+		end
+	end
 end
