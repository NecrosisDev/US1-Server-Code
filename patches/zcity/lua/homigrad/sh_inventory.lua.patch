+	-- PLAN-BEGIN (plain Lua on purpose: tests/test_plan.py runs this block under lupa)
+	local function planSearch(entries, cfg)
+		local openDelay, settle = 0.1, 0.15
+		local n = #entries
+		local countEnd = openDelay + n * cfg.countStep + settle
+		local cursor = countEnd
+		local firstUnknown = true
+		for i = 1, n do
+			local e = entries[i]
+			e.appearAt = openDelay + (i - 1) * cfg.countStep
+			if e.known then
+				e.scanAt, e.foundAt = e.appearAt, e.appearAt
+			else
+				local dur = 0
+				if not firstUnknown then dur = cfg.itemTime * (e.rare and cfg.rareMul or 1) end
+				firstUnknown = false
+				e.scanAt, e.foundAt = cursor, cursor + dur
+				cursor = cursor + dur
+			end
+		end
+		return countEnd, cursor
+	end
