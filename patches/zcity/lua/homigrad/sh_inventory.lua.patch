+	hook.Add("OnNetVarSet","inventory_netvar",function(index,key,var)
+		if key == "Inventory" then
+			local ent = Entity(index)
+
+			if IsValid(plyMenu) and plyMenu.entindex == index then
+				timer.Simple(0,function()
+					--OpenInv(ent)
+				end)
+			end
+		end
