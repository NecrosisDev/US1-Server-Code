+	local SHORT_KEYS = {MOUSE1 = "M1", MOUSE2 = "M2", MOUSE3 = "M3", MOUSE4 = "M4", MOUSE5 = "M5", SHIFT = "SHF", CTRL = "CTL", SPACE = "SPC"}
