+local retryWarningTime, retryWarningCount = -math.huge, 0
+local function ReportLuaBulletRetry(reason)
+    -- Diagnostic only: bounded output, no work moved to a later tick.
+    if not SERVER or retryWarningCount >= 10 or SysTime() - retryWarningTime < 10 then return end
+    retryWarningTime, retryWarningCount = SysTime(), retryWarningCount + 1
+    ErrorNoHalt("[ZCity bullets] Aborted invalid body retrace: " .. reason .. "\n")
+end
+local function LuaBulletRetryStart(hit, start, direction, endpoint)
+    if not isvector(hit) then return nil, "missing_hit_position" end
+    local proposed = hit + direction * 1
+    for i = 1, 3 do
+        if not (proposed[i] > -math.huge and proposed[i] < math.huge) then
+            return nil, "nonfinite_position"
+        end
+    end
+    local advance = (proposed - start):Dot(direction)
+    local remaining = (endpoint - proposed):Dot(direction)
+    if not (advance > 0 and advance < math.huge) then return nil, "nonadvancing" end
+    if not (remaining >= 0 and remaining < math.huge) then return nil, "past_endpoint" end
+    return proposed
+end
