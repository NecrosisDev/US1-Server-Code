+function ENTITY:FireLuaBullets(tInfo)
+    if hook.Run("EntityFireBullets", self, tInfo) == false then return end
+    local owner = tInfo.Attacker and tInfo.Attacker:IsValid() and tInfo.Attacker or IsValid(self) and self:GetOwner() and self:GetOwner():IsValid() and self:GetOwner() or self
+    local bIsPlayer = owner:IsPlayer()
+    local volley = tInfo.__ZCVolley
+    local needsCompensation = bIsPlayer and not tInfo.DisableLagComp and not (volley and volley.lagCompensated)
+    if not needsCompensation then
+        FireLuaBulletsBody(self, tInfo, owner, bIsPlayer)
+        return
+    end
+    if CLIENT then
+        owner:LagCompensation(true)
+        local completed = FireLuaBulletsBody(self, tInfo, owner, bIsPlayer)
+        if completed ~= false then owner:LagCompensation(false) end
+        return
+    end
+    if activeLuaBulletOwner then
+        assert(activeLuaBulletOwner == owner,
+            "Cross-attacker nested Lua bullets require DisableLagComp; outer scope preserved")
+        FireLuaBulletsBody(self, tInfo, owner, bIsPlayer)
+        return
+    end
+    local closeCompensation = owner.LagCompensation
+    closeCompensation(owner, true)
+    activeLuaBulletOwner = owner
+    local ok, failure = xpcall(FireLuaBulletsBody, CaptureLuaBulletError,
+        self, tInfo, owner, bIsPlayer)
+    local closed, closeError = pcall(closeCompensation, owner, false)
+    activeLuaBulletOwner = nil
+    if not ok then
+        if not closed then ErrorNoHalt("[ZCity bullets] Cleanup also failed: " .. tostring(closeError) .. "\n") end
+        if isstring(failure.value) then error(failure.value .. "\n" .. failure.traceback, 0) end
+        error(failure.value, 0)
+    end
+    if not closed then error(closeError, 0) end
 end
 
