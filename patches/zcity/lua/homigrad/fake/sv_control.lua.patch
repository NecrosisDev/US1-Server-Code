+-- The two ground probes below are pure queries (util.TraceLine has no side effects) and each costs ~1.3 KB of garbage
+-- (input tables, vectors, the ~23-field result table). They are built exactly as before, but only when the result is read.
+local function fakeGroundHit(ply, ragdoll)
+	local tr = {}
+	tr.start = ply:GetPos()
+	tr.endpos = ply:GetPos() - vector_up * 10
+	tr.filter = {ply,ragdoll}
+	return util.TraceLine(tr).Hit
+end
+
+local function fakeSpineOnGround(spine, ply, ragdoll)
+	return util.TraceLine({
+			start = spine:GetPos(),
+			endpos = spine:GetPos() - vector_up * 58,
+			filter = {ply, ragdoll},
+			mask = MASK_SOLID,
+		}).Hit
+end
+
+-- scratch input table for the hand / choke traces. Only ever handed to util.TraceLine, which reads it and keeps no
+-- reference; cleared per ragdoll so it behaves exactly like the fresh `{}` it replaces (mask must not leak across ragdolls).
