+local function IncludeZCityFile(path)
+    if CLIENT and string.StartWith(path, "initpost/") then
+        local ok,err=xpcall(function()include(path)end,debug.traceback)
+        if not ok then
+            ErrorNoHalt("[ZCity UI] "..path..": "..tostring(err).."\n")
+            if ZCUIRecovery then ZCUIRecovery.errors[path]=tostring(err)end
+        end
+        return
+    end
+    return include(path)
+end
