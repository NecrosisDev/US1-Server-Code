# Source-only allowlist: assets, archives, databases and live cfg files stay ignored.
*
!*/
!.gitignore
!.gitattributes
!/README.md
!*.lua
!*.luau
!*.moon
!*.js
!*.mjs
!*.cjs
!*.jsx
!*.ts
!*.tsx
!*.html
!*.htm
!*.css
!*.scss
!*.sass
!*.less
!*.vue
!*.svelte
!*.py
!*.sh
!*.bash
!*.ps1
!*.bat
!*.cmd
!*.c
!*.cc
!*.cpp
!*.cxx
!*.h
!*.hh
!*.hpp
!*.hxx
!*.cs
!*.rs
!*.go
!*.java
!*.kt
!*.glsl
!*.hlsl
!*.fx
!*.nut
!*.cmake
!addon.json
!package.json
!package-lock.json
!tsconfig.json
!CMakeLists.txt
!Makefile
!Dockerfile
!requirements.txt
!pyproject.toml
!Cargo.toml
!Cargo.lock
!go.mod
!go.sum
!LICENSE
!LICENSE.txt
!LICENSE.md
!COPYING
!NOTICE

# Runtime and private directories remain excluded even when they contain scripts.
/garrysmod/data/
/garrysmod/cache/
/garrysmod/download/
/garrysmod/downloads/
/garrysmod/downloadlists/
/garrysmod/logs/
/garrysmod/vprof/
**/.svn/
**/.hg/
**/.ssh/
**/node_modules/
**/__pycache__/
**/.env*
**/private-originals/
**/.private/
*.pem
*.key
*.p12
*.pfx

# Reviewed repository documentation and addon inventory (not asset payloads).
!/docs/*.md
!/manifests/addon-packages.json
!/manifests/consolidation-audit.json

# Generated releases are not source; a Lua extension must not re-include them.
/build/
/dist/

# Reviewed storage metadata and placeholder-only developer configuration.
!/manifests/storage-audit.json
!/config/examples/mysql-dev.cnf.example

# Restructured layout (see docs/ARCHITECTURE.md).
!*.patch
!*.md
!*.yml
!/.glualint.json
!/manifests/*.json
/.cache/

# Built drops and cutover folders are outputs, not source.
/drops/
